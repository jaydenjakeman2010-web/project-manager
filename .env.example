# ── Server ──
PORT=3001
NODE_ENV=development

# ── Database ──
# Railway Postgres auto-injects this; local dev use Docker or your own Postgres
DATABASE_URL=postgresql://postgres:dev@localhost:5432/project_manager

# ── JWT ──
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-128-char-hex-string
JWT_EXPIRES_IN=7d

# ── Google OAuth ──
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── GitHub OAuth ──
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ── CORS ──
# Comma-separated origins allowed in development
CORS_ORIGIN=http://localhost:3001

# ── Uploads ──
# Max file size in bytes (default 5MB)
MAX_UPLOAD_SIZE=5242880
