# ── Server ──
PORT=3001
NODE_ENV=development

# ── Database ──
# Railway Postgres auto-injects this; local dev use Docker or your own Postgres
DATABASE_URL=postgresql://postgres:dev@localhost:5432/project_manager

# ── JWT ──
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-128-char-hex-string
JWT_EXPIRES_IN=7d

# ── SMTP (Email) ──
# Used to send verification and password reset emails.
# For development, leave these blank and emails will be captured at ethereal.email (see server logs).
# For production, use SendGrid, Mailgun, Gmail App Password, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Project Manager
EMAIL_FROM_ADDRESS=

# ── CORS ──
CORS_ORIGIN=http://localhost:3001

# ── Uploads ──
MAX_UPLOAD_SIZE=5242880
